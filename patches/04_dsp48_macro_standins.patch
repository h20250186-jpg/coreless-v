# Stand-ins for xbip_dsp48_macro_1 / _2, which their rtl/EVA/EVA_update.v instantiates
# but their repository does not ship. NEW files written for this project (ASSUMED
# functions, not checked against the original IP); the same two files are also in
# external/iisc_sim/ of this package. _missing = A*B+C and (D+A)*B+C, one register;
# _zero = all outputs 0 (sensitivity test). Both give identical results on every
# run where they were compared: RESULTS.md "Data-TLB stand-in probe" and
# "A.1 - DSP-macro stand-ins during inference".
# The Vivado 2026.1 copies (external_2026/iisc_copy/, iisc_paper_cfg/) use _missing.

--- /dev/null
+++ b/external/iisc_sim/xbip_dsp48_macro_missing.v
@@ -0,0 +1,32 @@
+`timescale 1ns / 1ps
+// STAND-INS for two IP cores that the I2SRV32-V repository instantiates
+// (rtl/EVA/EVA_update.v) but does NOT ship: there is no xbip_dsp48_macro_1 or
+// xbip_dsp48_macro_2 container in "Source code/IP". Their real configuration
+// (function, signedness, pipeline depth) is therefore unknown.
+//
+// They sit in the EVA replacement-ranking logic of the ITLB/TLB, i.e. they only
+// influence WHICH translation entry is chosen for eviction. The functions below
+// are ASSUMPTIONS made from the port lists and from xbip_dsp48_macro_0 (A*B,
+// one M register); they have not been checked against the original IP.
+//   xbip_dsp48_macro_1 : P = A*B + C         (ports A, B, C)
+//   xbip_dsp48_macro_2 : P = (D + A)*B + C   (ports A, B, C, D)
+module xbip_dsp48_macro_1 (
+    input  wire               CLK,
+    input  wire signed [17:0] A,
+    input  wire signed [17:0] B,
+    input  wire signed [47:0] C,
+    output reg  signed [47:0] P
+);
+    always @(posedge CLK) P <= A * B + C;
+endmodule
+
+module xbip_dsp48_macro_2 (
+    input  wire               CLK,
+    input  wire signed [17:0] A,
+    input  wire signed [17:0] B,
+    input  wire signed [47:0] C,
+    input  wire signed [17:0] D,
+    output reg  signed [47:0] P
+);
+    always @(posedge CLK) P <= (D + A) * B + C;
+endmodule
--- /dev/null
+++ b/external/iisc_sim/xbip_dsp48_macro_zero.v
@@ -0,0 +1,25 @@
+`timescale 1ns / 1ps
+// SENSITIVITY-TEST stand-ins for xbip_dsp48_macro_1 / _2 (not shipped by the
+// I2SRV32-V repository). Same ports as xbip_dsp48_macro_missing.v, but every
+// output is tied to 0: a deliberately DIFFERENT assumed function, used only
+// to check whether the conv8_3 cycle count depends on what the stand-ins do.
+module xbip_dsp48_macro_1 (
+    input  wire               CLK,
+    input  wire signed [17:0] A,
+    input  wire signed [17:0] B,
+    input  wire signed [47:0] C,
+    output wire signed [47:0] P
+);
+    assign P = 48'sd0;
+endmodule
+
+module xbip_dsp48_macro_2 (
+    input  wire               CLK,
+    input  wire signed [17:0] A,
+    input  wire signed [17:0] B,
+    input  wire signed [47:0] C,
+    input  wire signed [17:0] D,
+    output wire signed [47:0] P
+);
+    assign P = 48'sd0;
+endmodule
