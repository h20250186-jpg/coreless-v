--- done_gen: process(illegal,terminal_count,start,reset,count_internal)
--- begin
-	-- if( (reset = '1') or (not(start) = '1') or (count_internal >= terminal_count) or(illegal = '1')) then
-		-- done_internal	<=	'1';
-	-- else
-		-- done_internal	<=	'0';
-	-- end if;
--- end process done_gen;
----------------------------------------
-done_gen: process(illegal,terminal_count,start,reset,count_internal)
+done_gen: process(illegal,terminal_count,start,reset,count_internal,started_r)
 begin
 	if ( (reset = '1') or (illegal = '1') ) then
 		done_internal <= '1';
 	elsif start = '0' then
 		done_internal <= '1';
-	elsif count_internal >= terminal_count then
+	elsif started_r = '0' then
+		-- First cycle after start: always active regardless of count vs terminal
+		done_internal <= '0';
+	elsif count_internal > terminal_count then
 		done_internal <= '1';
 	else
 		done_internal <= '0';
 	end if;
 end process done_gen;
